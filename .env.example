# AI 服务（兼容 OpenAI Chat Completions 接口）
AI_BASE_URL=http://your-llm-host:port/v1
AI_MODEL=your-model-name
AI_API_KEY=your-api-key

# 自定义 / 企业邮箱 SMTP（已内置 163/126/QQ/Gmail/Outlook/Yahoo 等主流服务商，无需填写）
# 使用未收录的企业域名时才需要配置
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# 自定义 / 企业邮箱 IMAP（同上）
IMAP_HOST=imap.example.com
IMAP_PORT=993
