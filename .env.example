# ── 数据库 ──────────────────────────────────────────────────────────────────
# 生产：PostgreSQL（与 docker-compose.yml 中的服务对应）
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/email_scheduler
# 本地开发也可以用 SQLite：
# DATABASE_URL=sqlite:///./email_scheduler.db

# PostgreSQL 容器密码（docker-compose 启动时用）
POSTGRES_PASSWORD=yourpassword

# ── JWT 认证 ─────────────────────────────────────────────────────────────────
# 用 openssl rand -hex 32 生成
JWT_SECRET=your-jwt-secret-key-here
AUTH_USERNAME=admin
AUTH_PASSWORD=your-admin-password

# ── AI 服务（兼容 OpenAI Chat Completions 接口）─────────────────────────────
AI_BASE_URL=http://your-llm-host:port/v1
AI_MODEL=your-model-name
AI_API_KEY=your-api-key

# ── 自定义 / 企业邮箱（已内置 163/126/QQ/Gmail/Outlook/Yahoo，无需填写）─────
# 仅在使用未收录的企业域名时才需要配置
SMTP_HOST=smtp.example.com
SMTP_PORT=465
IMAP_HOST=imap.example.com
IMAP_PORT=993
